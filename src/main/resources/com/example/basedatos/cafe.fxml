<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="261.0" prefWidth="651.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.basedatos.CafeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Pane prefHeight="200.0" prefWidth="245.0">
        <children>
            <Label text="ID" />
            <Label layoutY="31.0" text="Productor" />
            <Label layoutX="2.0" layoutY="100.0" text="Variedad" />
            <Label layoutX="2.0" layoutY="64.0" text="Cantidad" />
            <TextField fx:id="textFieldID" layoutX="95.0" layoutY="-4.0" />
            <TextField fx:id="textFieldProductor" layoutX="95.0" layoutY="27.0" />
            <TextField fx:id="textFieldCantidad" layoutX="95.0" layoutY="60.0" />
            <ComboBox fx:id="comboVariedad" layoutX="95.0" layoutY="96.0" prefWidth="150.0" />
            <TableView fx:id="tablaCafe" layoutX="291.0" layoutY="-4.0" onMouseClicked="#clicInformacion" prefHeight="200.0" prefWidth="306.0" />
            <Button layoutY="140.0" mnemonicParsing="false" onAction="#clicAgregar" text="Agregar" />
            <Button layoutX="78.0" layoutY="140.0" mnemonicParsing="false" onAction="#clicEditar" text="Editar" />
            <Button layoutX="144.0" layoutY="140.0" mnemonicParsing="false" onAction="#clicBorrar" text="Borrar" />
        </children>
    </Pane>
</VBox>
